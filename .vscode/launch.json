{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug launch target (lldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${command:cmake.getLaunchTargetDirectory}"
    },
    {
      "name": "Debug CTest test (lldb)",
      "type": "lldb",
      "request": "launch",
      "presentation": { "hidden": true },
      "program": "${cmake.testProgram}",
      "args": ["${cmake.testArgs}"],
      "cwd": "${cmake.testWorkingDirectory}"
    },
    {
      "name": "Debug launch target (cppdbg)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "MIMode": "gdb",
      "osx": { "MIMode": "lldb" },
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug CTest test (cppdbg)",
      "type": "cppdbg",
      "request": "launch",
      "presentation": { "hidden": true },
      "program": "${cmake.testProgram}",
      "args": ["${cmake.testArgs}"],
      "cwd": "${cmake.testWorkingDirectory}",
      "environment": "${cmake.testEnvironment}",
      "MIMode": "gdb",
      "osx": { "MIMode": "lldb" },
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
