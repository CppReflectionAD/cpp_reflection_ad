[submodule "clang-p2996"]
	path = clang-p2996
	url = https://github.com/siqiyyyy/clang-p2996.git
	branch = expr-reflect
[submodule "gcc-mirror"]
	path = gcc-mirror
	url = https://github.com/yesmanchyk/gcc-mirror.git
	branch = autograd-capable
[submodule "gcc-darwin-reflect"]
	path = gcc-darwin-reflect
	url = https://github.com/CppReflectionAD/gcc-darwin-arm64.git
	branch = p4395
	# Our fork of iains/gcc-darwin-arm64: an iains snapshot with gcc-mirror's
	# reflection commits cherry-picked on top. See "Bumping a compiler pin" in
	# CONTRIBUTING.md.
[submodule "gcc"]
	path = gcc
	url = git@github.com:CppReflectionAD/gcc.git
	branch = p4395ci
