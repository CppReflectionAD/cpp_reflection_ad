[submodule "clang-p2996"]
	path = clang-p2996
	url = https://github.com/siqiyyyy/clang-p2996.git
	branch = expr-reflect
[submodule "gcc-mirror"]
	path = gcc-mirror
	url = https://github.com/yesmanchyk/gcc-mirror.git
	branch = autograd-capable
[submodule "gcc-darwin-reflect"]
	path = gcc-darwin-reflect
	url = https://github.com/CppReflectionAD/gcc-darwin-arm64.git
	branch = master-wip-apple-si-on-r17-4662-g386d81e74305e7
	# A fork of iains/gcc-darwin-arm64; see "Building the compilers" in
	# CONTRIBUTING.md. Before moving the pin to a newer iains snapshot, push
	# that snapshot's branch from iains to the fork, or `git submodule update`
	# fails with "not our ref".
	# The pin must be an upstream iains snapshot commit whose GCC base matches
	# gcc-mirror's upstream merge-base. run_tests.py applies the reflection
	# commits on top of it locally (git am), so ignore=all keeps those local-only
	# commits from being committed as the pin. Bump it deliberately with:
	#   git update-index --cacheinfo 160000,<sha>,gcc-darwin-reflect
	ignore = all
